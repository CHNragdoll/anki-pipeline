{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/project-standard/control-catalog.schema.json",
  "title": "Universal Project Standard Control Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standardVersion",
    "evidenceStates",
    "riskLevels",
    "controlFamilies",
    "controls"
  ],
  "properties": {
    "standardVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "evidenceStates": {
      "type": "array",
      "prefixItems": [
        { "const": "PASS" },
        { "const": "FAIL" },
        { "const": "NOT_RUN" },
        { "const": "BLOCKED" },
        { "const": "NOT_APPLICABLE" },
        { "const": "PRIOR_PASS" },
        { "const": "DISCOVERED" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true
    },
    "riskLevels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/namedId" }
    },
    "controlFamilies": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/namedId" }
    },
    "controls": {
      "type": "array",
      "minItems": 50,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "namedId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "level",
        "title",
        "requirement",
        "gate",
        "evidenceKinds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-\\d{3}$"
        },
        "family": {
          "enum": ["GOV", "REQ", "ARC", "VCS", "QLT", "SEC", "SUP", "DAT", "REL", "OPS", "DOC"]
        },
        "level": {
          "enum": ["MUST", "SHOULD"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "enum": ["change", "review", "release", "delivery", "production", "retirement"]
        },
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
