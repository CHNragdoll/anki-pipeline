+    "C": {
+        "nodes": {5: (65.5, 8.25), 2: (39.75, 28), 8: (92.25, 28),
+                  1: (23, 48.25), 4: (55.25, 47.75), 6: (76.5, 47.75),
+                  9: (107.75, 47.75), 3: (39.5, 68.25), 7: (91.75, 68.25)},
+        "edges": ((5, 2, "L"), (5, 8, "R"), (2, 1, "L"), (2, 4, "R"),
+                  (8, 6, "L"), (8, 9, "R"), (4, 3, "L"), (6, 7, "R")),
+    },
+    "D": {
+        "nodes": {5: (79.75, 8.25), 3: (53.5, 28), 8: (106.25, 28),
+                  2: (37, 48), 4: (69.5, 47.5), 7: (90.25, 48),
+                  10: (122, 48), 1: (20, 68), 6: (73.25, 68),
+                  9: (106.25, 68)},
+        "edges": ((5, 3, "L"), (5, 8, "R"), (3, 2, "L"), (3, 4, "R"),
+                  (8, 7, "L"), (8, 10, "R"), (2, 1, "L"), (7, 6, "L"),
+                  (10, 9, "L")),
+    },
+}
+
+ANSWER_SLOTS = ((0, 0, 174, 83), (174, 0, 174, 83),
+                (0, 83, 174, 83), (174, 83, 174, 83))
+QUESTION_SLOTS = ((0, 0, 200, 67), (200, 0, 202, 67),
+                  (0, 67, 200, 72), (200, 67, 202, 72))
+
+
+def check_source(path: Path, expected: str) -> None:
+    actual = hashlib.sha256(path.read_bytes()).hexdigest()
+    if actual != expected:
+        raise ValueError(f"source figure changed: {path}: {actual}")
+
+
+def visible_bounds(nodes: dict[int, tuple[float, float]]) -> tuple[float, float, float, float]:
+    xs = [point[0] for point in nodes.values()]
+    ys = [point[1] for point in nodes.values()]
+    extent = RADIUS + STROKE_WIDTH / 2
+    return min(xs) - extent, min(ys) - extent, max(xs) + extent, max(ys) + extent
+
+
+def center_transform(nodes: dict[int, tuple[float, float]], width: int, height: int,
+                     *, fit: bool) -> str:
+    left, top, right, bottom = visible_bounds(nodes)
+    # Preserve the previous question-figure scale; only its centering formula
+    # is stated in terms of the visible geometry, including stroke width.
+    scale = min((width - 6) / (right - left - STROKE_WIDTH),
+                (height - 6) / (bottom - top - STROKE_WIDTH)) if fit else 1.0
+    dx = (width - scale * (left + right)) / 2
+    dy = (height - scale * (top + bottom)) / 2
+    return f'translate({dx:.4f} {dy:.4f}) scale({scale:.6f})'
+
+
+def render(width: int, height: int, slots: tuple[tuple[int, int, int, int], ...],
+           *, fit: bool) -> str:
+    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
+             f'viewBox="0 0 {width} {height}" role="img" aria-label="四个二叉树选项图">',
+             '<g fill="white" stroke="#333" stroke-width="0.7" '
+             'stroke-linecap="round" stroke-linejoin="round">']
+    for label, (left, top, slot_width, slot_height) in zip("ABCD", slots):
+        tree = TREES[label]
+        nodes, edges = tree["nodes"], tree["edges"]
+        assert len(edges) == len(nodes) - 1
+        assert all(parent in nodes and child in nodes for parent, child, _ in edges)
+        assert all(RADIUS <= x <= 174 - RADIUS and RADIUS <= y <= 83 - RADIUS
+                   for x, y in nodes.values())
+        parts.append(f'<g transform="translate({left} {top})">')
+        parts.append(f'<g transform="{center_transform(nodes, slot_width, slot_height, fit=fit)}">')
+        for parent, child, _ in edges:
+            x1, y1 = nodes[parent]
+            x2, y2 = nodes[child]
+            parts.append(f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}"/>')
+        for x, y in nodes.values():
+            parts.append(f'<circle cx="{x}" cy="{y}" r="{RADIUS}"/>')
+        parts.append('</g>')
+        parts.append('</g>')
+    parts.extend(['</g>', '</svg>', ''])
+    return '\n'.join(parts)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--answers-source', type=Path, default=ANSWER_SOURCE)
+    parser.add_argument('--questions-source', type=Path, default=QUESTION_SOURCE)
+    args = parser.parse_args()
+    check_source(args.answers_source, ANSWER_SHA256)
+    check_source(args.questions_source, QUESTION_SHA256)
+    ASSETS.mkdir(parents=True, exist_ok=True)
+    ANSWER_OUTPUT.write_text(render(348, 166, ANSWER_SLOTS, fit=False), encoding='utf-8')
+    QUESTION_OUTPUT.write_text(render(402, 139, QUESTION_SLOTS, fit=True), encoding='utf-8')
+
+
+if __name__ == '__main__':
+    main()
