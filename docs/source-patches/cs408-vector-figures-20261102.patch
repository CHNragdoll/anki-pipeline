+"""Draw label-free vector choices for the 2009 CS408 Q4 tree figure.
+
+The original extracted figure is kept as source evidence. This derivative has
+the same 373 x 86 viewBox and the same four crop slots as the original.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "data/sources/cs408-latex-2009-2017/assets/figures/2009-complete-p001-b007.svg"
+OUTPUT = ROOT / "data/sources/exam-library/assets/redrawn/cs408-2009-complete-p001-b007-clean.svg"
+PDF_OUTPUT = ROOT / "data/sources/cs408-latex-2009-2017/assets/figures/2009-complete-p001-b007-clean.pdf"
+SOURCE_SHA256 = "51c408fe96bc76e8ba57fd177c736f062862e00a2842d94cfb63b46062f2e10a"
+
+# Node coordinates are local to the four original crop slots. Connections
+# record the exact parent-child topology seen in the source PDF figure.
+# A: root -> left -> right. B: root -> left/right, each with a left leaf.
+# C: root -> left/right; right -> right -> left.
+# D: root -> left/right; left -> left/right; left-left -> right -> right.
+TREES = (
+    (0, ((47.5, 25), (32.3, 49.5), (51, 69.5)), ((0, 1), (1, 2))),
+    (72, ((56, 22), (41, 45), (71, 45), (27, 66.5), (58, 67)),
+     ((0, 1), (0, 2), (1, 3), (2, 4))),
+    (156, ((33.5, 15.8), (20, 35.8), (46.3, 36), (61.5, 54.8), (48.8, 71)),
+     ((0, 1), (0, 2), (2, 3), (3, 4))),
+    (229, ((44.8, 12.3), (32.5, 30.8), (61.3, 32.8), (20.3, 48.5),
+           (48.8, 48.3), (36.5, 60.8), (53, 72.8)),
+     ((0, 1), (0, 2), (1, 3), (1, 4), (3, 5), (5, 6))),
+)
+CROP_SLOTS = ((0, 0, 72, 86), (72, 0, 84, 86),
+              (156, 0, 73, 86), (229, 0, 72, 86))
+RADIUS = 7.4
+STROKE_WIDTH = 0.8
+
+
+def visible_bounds(nodes: tuple[tuple[float, float], ...]) -> tuple[float, float, float, float]:
+    extent = RADIUS + STROKE_WIDTH / 2
+    return (min(x for x, _ in nodes) - extent,
+            min(y for _, y in nodes) - extent,
+            max(x for x, _ in nodes) + extent,
+            max(y for _, y in nodes) + extent)
+
+
+def draw_svg() -> str:
+    parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="373" height="86" '
+             'viewBox="0 0 373 86" role="img" aria-label="四棵候选二叉排序树">',
+             '<g fill="white" stroke="#999" stroke-width="0.8" '
+             'stroke-linecap="round" stroke-linejoin="round">']
+    for (offset, nodes, edges), (left, top, width, height) in zip(TREES, CROP_SLOTS):
+        assert offset == left
+        x0, y0, x1, y1 = visible_bounds(nodes)
+        dx = width / 2 - (x0 + x1) / 2
+        dy = height / 2 - (y0 + y1) / 2
+        parts.append(f'<g transform="translate({offset + dx:.4f} {top + dy:.4f})">')
+        for parent, child in edges:
+            x1, y1 = nodes[parent]
+            x2, y2 = nodes[child]
+            parts.append(f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}"/>')
+        for x, y in nodes:
+            parts.append(f'<circle cx="{x}" cy="{y}" r="{RADIUS}"/>')
+        parts.append('</g>')
+    parts.extend(['</g>', '</svg>', ''])
+    return '\n'.join(parts)
+
+
+def main() -> None:
+    source_path = Path(sys.argv[1]) if len(sys.argv) == 2 else SOURCE
+    actual = hashlib.sha256(source_path.read_bytes()).hexdigest()
+    if actual != SOURCE_SHA256:
+        raise ValueError(f"source figure changed: {actual}")
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT.write_text(draw_svg(), encoding='utf-8')
+    subprocess.run(["rsvg-convert", "-f", "pdf", str(OUTPUT), "-o", str(PDF_OUTPUT)], check=True)
+
+
+if __name__ == "__main__":
+    main()
