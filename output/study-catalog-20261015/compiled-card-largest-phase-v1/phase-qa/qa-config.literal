)=>({src:audio.src,currentSrc:audio.currentSrc,srcAttribute:audio.getAttribute('src'),ready:audio.readyState,network:audio.networkState,connected:audio.isConnected,ownerCurrent:audio.ownerDocument===doc,ownRealmPrototype:audio instanceof win.HTMLMediaElement,mediaError:audio.error?.message});if(packet.metricsAsset){row.audio=row.audio||{attempts:0,denied:0,errors:[],events:[]};for(const event of ['loadstart','loadedmetadata','canplay','error','abort','emptied','stalled','suspend'])audio.addEventListener(event,()=>{row.audio.events.push({event,at:clock(),...details()});if(row.audio.events.length>24)row.audio.events.shift();report()})}Object.defineProperty(audio,'play',{configurable:true,writable:true,value:function(...args){if(packet.metricsAsset){row.audio.attempts++;row.audio.userActivation=win.navigator.userActivation?.isActive;row.audio.call={...details(),play:String(play).slice(0,180),targetRealmPlay:String(win.HTMLMediaElement.prototype.play).slice(0,180)};report()}if(active.node!==side){row.audioAttempts=(row.audioAttempts||0)+1;if(row.audio)row.audio.denied++;return Promise.reject(Error('Prepared media cannot play before commit'))}try{const result=Reflect.apply(play,this,args);if(!packet.metricsAsset)return result;return Promise.resolve(result).catch(error=>{row.audio.errors.push({name:error.name,message:error.message,stack:error.stack,...details()});if(row.audio.errors.length>4)row.audio.errors.shift();report();throw error})}catch(error){if(row.audio){row.audio.errors.push({name:error.name,message:error.message,stack:error.stack,...details()});report()}throw error}}})}copyAttributes(parsed.documentElement,doc.documentElement);copyAttributes(parsed.body,doc.body);doc.head.replaceChildren(head);doc.body.replaceChildren(body);compiledProfiles.bind(win,doc,compiled,()=>packet===current&&active.packet===packet&&active.viewToken===token&&active.doc===doc&&active.node.isConnected&&active.node.contentDocument===doc);win.scrollTo(0,0);history?.bind(doc,()=>active.packet===packet&&active.viewToken===token&&active.doc===doc&&active.node.contentDocument===doc);phase?.point('body-connected');\n // Authored scripts still run in source order. Their repeated calls to our\n // bridge are coalesced so they cannot force intermediate whole-card layouts.\n const authoredComplete=win.__ankiCigenFrames.batch(()=>{for(const item of scripts){if(!valid())return false;if(packet.prepared.modules?.[item.pin]){item.node.remove();continue}const qaAuthorStarted=phase?.now();try{execute(doc,item.code,item.pin)}finally{phase?.span('author-execute',qaAuthorStarted,item.pin)}item.node.remove()}return true},phase);if(!authoredComplete||!valid())return null;phase?.point('authors-complete');\n // Media adopted from the inert parser may retain a rejected temporary-URL\n // selection. Reset only after the final base and complete body are connected;\n // load() preserves authored preload/src and never starts playback.\n for(const media of doc.querySelectorAll('audio,video'))if(media.getAttribute('src')||media.querySelector('source[src]'))media.load();phase?.point('media-reset-complete');\n if(packet.metricsAsset&&packet.audioDiagnostics)installAudioDiagnostic(win,doc,row);if(!valid())return null;\n if(packet.metricsAsset){row.preparedBodyAt=clock();row.events.push({event:'connected-prepared-body',at:clock(),...snapshot(doc)});}const historyBegan=performance.now();phase?.point('full-gate-start');if(history?.count){if(!await awaitStaticHistoryNative(active,valid,historyBegan))return null;history.restore()}if(!await waitPrepared(active,valid,history?.count?historyBegan:null))return null;phase?.point('full-gate-complete');if(packet.metricsAsset){row.readyAt=clock();row.prepared=snapshot(doc);report();}return{entry:active,doc,packet,index,row,token,geometry:JSON.stringify(snapshot(doc,false))};}finally{history?.cleanup()}\n}\nfunction installAudioDiagnostic(win,doc,row){const box=doc.createElement('div');box.style.cssText='position:fixed;bottom:4px;right:4px;z-index:999999;background:white;border:1px solid #aaa;padding:5px';for(const [label,reset]of [['诊断：原生播放韦氏',false],['诊断：load 后播放韦氏',true]]){const button=doc.createElement('button');button.textContent=label;button.onclick=()=>{const audio=doc.querySelector('audio[data-dictionary-source=\"webster\"]')||doc.querySelector('audio');if(!audio)return;const log=extra=>{row.audio.diagnostic={reset,src:audio.src,currentSrc:audio.currentSrc,ready:audio.readyState,network:audio.networkState,...extra};report()};try{if(reset)audio.load();const job=reset?audio.play():Reflect.apply(win.HTMLMediaElement.prototype.play,audio,[]);Promise.resolve(job).then(()=>log({result:'resolved',duration:audio.duration})).catch(error=>log({result:'rejected',name:error.name,message:error.message}))}catch(error){log({result:'threw',name:error.name,message:error.message})}};box.append(button)}doc.body.append(box)}\nfunction clearOld(entry){if(!entry?.doc)return;const {win,doc}=entry;for(const name of ['AnkiSlimApkgDispose','__ankiExamCountdownCleanup'])if(typeof win[name]==='function')win[name]();for(const audio of doc.querySelectorAll('audio'))audio.pause();compiledProfiles.clear(doc);doc.body.replaceChildren();win.__ankiCigenFrames.refresh();win.__ankiCardChunkState=null;entry.packet=null;entry.viewToken=null}\nfunction ownsView(view){return !!view&&view.packet===current&&view.entry.packet===view.packet&&view.entry.viewToken===view.token&&view.entry.doc===view.doc&&view.entry.node.isConnected&&view.entry.node.contentDocument===view.doc}\nfunction currentPreparation(view){if(!ownsView(view)||view.doc.fonts?.status==='loading')return false;view.entry.win.__ankiCigenFrames.refresh();for(const frame of view.doc.querySelectorAll('iframe.etymology-source-frame')){if(frame.getBoundingClientRect().width\u003c=0)continue;const state=view.entry.win.__ankiCigenFrames.known.get(frame);if(!state?.ready||state.readySignature!==state.signature||Math.abs(state.readyWidth-frame.getBoundingClientRect().width)>1)return false}return view.geometry===JSON.stringify(snapshot(view.doc,false))}\nfunction promote(view,requestedAt){if(!currentPreparation(view))return false;const previous=realms.find(entry=>entry.node===side);if(previous&&previous!==view.entry)stage(previous.node);side=view.entry.node;side.id='study-side';side.inert=false;side.removeAttribute('aria-hidden');side.style.cssText='display:block;width:100%;height:100%;border:0';answer=!!view.index;side.title=answer?'学习卡片背面':'学习卡片正面';record=current.metricsAsset?view.row:null;if(record){record.side=answer?'back':'front';record.request=requestedAt;record.mount=clock();record.events.push({event:'complete-card-commit',at:clock(),...snapshot(view.doc)});}side.dataset.mountReason='connected-complete-card';side.dataset.cardId=current.id;flip.textContent=answer?'返回正面':'显示答案';flip.setAttribute('aria-pressed',String(answer));working=false;flip.disabled=false;state();observe(view.doc,record,view.token);if(previous!==view.entry){for(const audio of previous?.doc?.querySelectorAll('audio,video')||[])audio.pause();if(previous?.packet!==view.packet)clearOld(previous)}report();return true}\nfunction getView(packet,index,requestedAt){const existing=preparedTasks[index];if(existing?.packet===packet&&(!existing.view||ownsView(existing.view)))return existing.promise;const task={packet,index,promise:null,view:null};task.promise=prepareView(packet,index,requestedAt).then(view=>{task.view=view;return view});preparedTasks[index]=task;task.promise.catch(()=>{});return task.promise}\nfunction prepareBack(packet){if(packet!==current||packet.frontOnly)return;const task=getView(packet,1,clock());task.catch(error=>{if(packet===current&&packet.metricsAsset){const row={card:packet.id,side:'back-preparation-failed',message:String(error.message||error)};records.push(row);report()}})}\nasync function show(requestedAt,index){const packet=current;working=true;flip.disabled=true;state();if(index&&packet.frontOnly){const session=frontSession;if(!session||session.packet!==packet||!await session.complete||current!==packet)return false}const view=await getView(packet,index,requestedAt);if(current!==packet||!view)return false;if(!currentPreparation(view)){if(!await waitPrepared(view.entry,()=>ownsView(view)))return false;view.geometry=JSON.stringify(snapshot(view.doc,false))}const result=promote(view,requestedAt);if(!result&&ownsView(view))throw Error('Prepared side lost readiness before commit');if(result&&!index)prepareBack(packet);return result}\n\nfunction canonicalJSON(value){return JSON.stringify(value,function(key,item){return item&&typeof item==='object'&&!Array.isArray(item)?Object.fromEntries(Object.keys(item).sort().map(name=>[name,item[name]])):item})}\nfunction accepts(packet,count){return !!packet&&Number.isSafeInteger(packet.token)&&packet.token>accepted&&packet.token>=reservedToken&&typeof packet.id==='string'&&!!packet.prepared&&Array.isArray(packet.sides)&&packet.sides.length===count&&packet.sides.every(value=>typeof value==='string')&&Array.isArray(packet.prepared.sides)&&packet.prepared.sides.length===count}\nfunction resourceBase(packet){const base=new URL(packet.base);if(base.origin!==origin||!['http:','https:'].includes(base.protocol))throw Error('Invalid prepared resource base');return base.href}\nfunction captureFront(packet){\n const binding=packet.deliveryBinding,hashes=['index_sha256','full_prepared_sha256','source_wrapper_sha256','source_payload_sha256','source_front_sha256'];\n if(!binding||hashes.some(name=>typeof binding[name]!=='string'||!/^[a-f0-9]{64}$/.test(binding[name]))||typeof binding.wrapper_url!=='string'||!binding.wrapper_url)throw Error('Invalid front delivery binding');\n if(packet.prepared.source_wrapper_sha256!==binding.source_wrapper_sha256||packet.prepared.source_payload_sha256!==binding.source_payload_sha256||packet.prepared.sides[0]?.proof?.source_sha256!==binding.source_front_sha256)throw Error('Front source binding differs');\n if(!Array.isArray(packet.baseTags)||packet.baseTags.length!==1||typeof packet.baseTags[0]!=='string')throw Error('Front resource base tag differs');\n const session={packet,binding:canonicalJSON(binding),source:packet.sides[0],side:canonicalJSON(packet.prepared.sides[0]),modules:canonicalJSON(packet.prepared.modules||{}),base:resourceBase(packet),baseTag:packet.baseTags[0],attached:false};\n session.complete=new Promise(resolve=>session.resolve=resolve);return session;\n}\nfunction startSession(packet,session){projectionTaskCloseAll();if(frontSession)frontSession.resolve(false);accepted=packet.token;reservedToken=Math.max(reservedToken,accepted);current=packet;preparedTasks=[];frontSession=session;return show(packet.requestedAt,0)}\nasync function attachComplete(packet){\n const session=frontSession,shown=current;if(!session||!shown||packet?.id!==shown.id||packet?.token!==accepted||session.packet!==shown)return false;\n try{\n  if(packet.frontOnly||!Array.isArray(packet.sides)||packet.sides.length!==2||!packet.sides.every(value=>typeof value==='string')||!Array.isArray(packet.prepared?.sides)||packet.prepared.sides.length!==2)throw Error('Complete attachment must contain both original sides');\n  if(canonicalJSON(packet.deliveryBinding)!==session.binding||packet.prepared.source_wrapper_sha256!==shown.deliveryBinding.source_wrapper_sha256||packet.prepared.source_payload_sha256!==shown.deliveryBinding.source_payload_sha256)throw Error('Complete attachment source binding differs');\n  if(resourceBase(packet)!==session.base||!Array.isArray(packet.baseTags)||packet.baseTags.length!==2||packet.baseTags[0]!==session.baseTag)throw Error('Complete attachment resource base differs');\n  if(canonicalJSON(packet.prepared.modules||{})!==session.modules)throw Error('Complete attachment module cohort differs');\n  if(packet.sides[0]!==session.source||shown.sides[0]!==session.source||canonicalJSON(packet.prepared.sides[0])!==session.side||canonicalJSON(shown.prepared.sides[0])!==session.side)throw Error('Complete attachment front differs');\n  if(session.attached){if(canonicalJSON(packet.sides)!==canonicalJSON(shown.sides)||canonicalJSON(packet.prepared)!==canonicalJSON(shown.prepared))throw Error('Complete attachment changed after verification');return true}\n  shown.sides=packet.sides;shown.prepared=packet.prepared;shown.baseTags=packet.baseTags;shown.frontOnly=false;session.attached=true;session.resolve(true);\n  const front=preparedTasks[0]?.view;if(front&&ownsView(front)&&front.entry.node===side)prepareBack(shown);return true;\n }catch(error){if(current===shown&&frontSession===session){session.resolve(false);fail(error,shown,accepted)}throw error}\n}\nfunction cancel(token){if(!Number.isSafeInteger(token)||token\u003c=accepted||token\u003c=reservedToken)return false;projectionTaskCloseAll();reservedToken=token;sequence++;if(frontSession)frontSession.resolve(false);frontSession=null;current=null;preparedTasks=[];record=null;working=false;flip.disabled=true;return true}\n\nfunction fail(error,packet,token){if(current!==packet||token!==accepted)return;working=false;flip.disabled=false;parent.postMessage({type:'study-source-error',id:packet.id,token:accepted,message:String(error.message||error),stack:error.stack},origin)}\nflip.onclick=()=>{if(!current||working)return;const packet=current,token=accepted;show(clock(),answer?0:1).catch(error=>fail(error,packet,token))};document.addEventListener('keydown',key);\nwindow.StudySharedFrame={cancel,attachComplete,async mountFront(packet){if(!accepts(packet,1)||packet.frontOnly!==true)return false;const session=captureFront(packet);return startSession(packet,session)},async mount(packet){if(!accepts(packet,2)||packet.frontOnly)return false;resourceBase(packet);return startSession(packet,null)}};\n})();\u003c/script>\u003c/body>\u003c/html>","policy":{"external":{"_as_numbering_9d1549871010e581820bad57.js":"9d1549871010e581820bad578577e1234f65d78f6725c6cc85a126c1ef5f84f1","_as_runtime_5c361607267287f859150ac4.js":"5c361607267287f859150ac4f7716d05b94a6ee5bebc0478d11660e947b6a15e","_study_171b1a051840b2488c00ebdfd97874e205fac661cdf44c67b042957a11d15e57.js":"171b1a051840b2488c00ebdfd97874e205fac661cdf44c67b042957a11d15e57","_study_71bcf5942a418885cd1b71065bb80504d3aba3fd658990cef739fe2706e83ee5.js":"71bcf5942a418885cd1b71065bb80504d3aba3fd658990cef739fe2706e83ee5","_study_9014f667e36b6b3094b212c110cb2af8b0bb910a89ba15ea7a052df50d5a96ba.js":"9014f667e36b6b3094b212c110cb2af8b0bb910a89ba15ea7a052df50d5a96ba","_study_ae91933dd0602830532df4ee6fe801a21e723e230ad62fc5e76147a7221fce57.js":"ae91933dd0602830532df4ee6fe801a21e723e230ad62fc5e76147a7221fce57","_study_afe4431fdd5254aa0b20c322ef3385a15a8a8ed8daddb6f6782f8866114fae3c.js":"afe4431fdd5254aa0b20c322ef3385a15a8a8ed8daddb6f6782f8866114fae3c","_study_b383335a30cfb0df90c14c394b505b655f2520350b09a8dea5fab8de8592a4b7.js":"b383335a30cfb0df90c14c394b505b655f2520350b09a8dea5fab8de8592a4b7"},"inline":[{"source":"(function(){\nconst key='__ankiCigenFrames';if(window[key]){window[key].refresh();return;}\nconst known=new WeakSet(),visible=new WeakSet();const selector='iframe.etymology-source-frame';\nfunction prepare(frame){const section=frame.closest('.etymology-section'),meaning=section?.closest('.meaning-section');if(!section||!meaning)return;const levels=[...meaning.children].find(item=>item.classList.contains('level-section'));if(levels&&(section.parentElement!==meaning||section.previousElementSibling!==levels))levels.after(section);if(section.style.marginTop!=='0.2rem'||section.style.marginBottom!=='0.65rem')section.style.margin='.2rem 0 .65rem';const sample=meaning.querySelector('.form-row')||meaning.querySelector('.primary-definition .field-content');if(sample){const text=getComputedStyle(sample);if(frame.style.fontSize!==text.fontSize)frame.style.fontSize=text.fontSize;if(frame.style.lineHeight!==text.lineHeight)frame.style.lineHeight=text.lineHeight;}}\nfunction theme(frame){const meaning=frame.closest('.meaning-section');if(!meaning)return;const text=getComputedStyle(frame),title=meaning.querySelector('.primary-definition .field-title'),callout=meaning.querySelector('.field-callout'),tag=meaning.querySelector('.level-list li');const metrics={'--ety-text-size':text.fontSize,'--ety-text-line':text.lineHeight};if(title){const style=getComputedStyle(title);Object.assign(metrics,{'--ety-title-size':style.fontSize,'--ety-title-line':style.lineHeight,'--ety-title-gap':style.marginBottom});}if(callout)metrics['--ety-section-space']=getComputedStyle(callout).paddingTop;if(tag){const style=getComputedStyle(tag);Object.assign(metrics,{'--ety-tag-size':style.fontSize,'--ety-tag-line':style.lineHeight,'--ety-tag-padding':style.padding,'--ety-tag-gap':getComputedStyle(tag.parentElement).gap});}frame.contentWindow.postMessage({type:'cigen:theme',metrics},'*');}\nfunction layout(frame){prepare(frame);if(!frame.contentWindow||frame.getBoundingClientRect().width\u003c=0)return;if(!visible.has(frame)){visible.add(frame);frame.style.height='1px';const source=frame.getAttribute('data-web-etymology-srcdoc');if(source!==null){frame.srcdoc=source;return;}}const style=getComputedStyle(frame);frame.contentWindow.postMessage({type:'cigen:layout',font:{fontFamily:style.fontFamily,fontSize:style.fontSize,lineHeight:style.lineHeight,color:style.color}},'*');theme(frame);}\nconst sizes=new ResizeObserver(entries=>{for(const entry of entries)layout(entry.target);});\nfunction refresh(){for(const frame of document.querySelectorAll(selector)){if(!known.has(frame)){known.add(frame);sizes.observe(frame);frame.addEventListener('load',()=>layout(frame));}layout(frame);}}\nwindow.addEventListener('message',event=>{const data=event.data;if(!data||data.type!=='cigen:size'||!Number.isFinite(data.height)||data.height\u003c=0)return;const frame=[...document.querySelectorAll(selector)].find(item=>item.contentWindow===event.source);if(!frame)return;const value=Math.ceil(data.height)+'px';if(frame.style.height!==value)frame.style.height=value;});\nnew MutationObserver(refresh).observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['class','style','hidden']});\nwindow.addEventListener('resize',refresh);window[key]={refresh};refresh();\n})();","src":"_study_deferred_inline_e938f4c52ba27633c8617a014f2e79f29c0abce1ed62c590ad74271c07d146de.js","sha256":"e938f4c52ba27633c8617a014f2e79f29c0abce1ed62c590ad74271c07d146de"},{"source":"// 2027 admissions: first exam begins 2026-12-19 08:30 Beijing time.\n// This fixed helper can also travel in Meta when Anki retains an older model.\n(function () {\n  var target = Date.parse(\"2026-12-19T08:30:00+08:00\");\n  var styleId = \"anki-exam-countdown-layout-v2\";\n  // Keep the upgrade self-contained in retained models. The countdown belongs\n  // to the card content, after its translated examples, rather than the window.\n  var layoutCss = [\n    // The client owns its reviewer shell and scrolling. In AnkiDroid #qa can\n    // be nested inside #content; a zero flex basis there collapses the card.\n    '.anki-countdown-content{box-sizing:border-box;display:block;flex:none;min-width:0;min-height:0;height:auto;width:100%;max-width:100%;overflow:visible}',\n    '.anki-countdown-content .exam-countdown{position:static!important;inset:auto!important;z-index:auto!important;transform:none!important;box-sizing:border-box;width:fit-content!important;max-width:100%!important;margin:.35rem 0 0 auto!important;padding:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;color:var(--pink,#b51c83);font-size:.8rem;line-height:1.6;text-align:right;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;pointer-events:none}'\n  ].join('\\n');\n  function stop() {\n    if (window.__ankiExamTimer) clearInterval(window.__ankiExamTimer);\n    window.__ankiExamTimer = null;\n  }\n  function ownsHost(state) {\n    return state && window.__ankiExamCountdownState === state\n      && document.documentElement.contains(state.host)\n      && state.content.parentElement === state.host && state.footer.parentElement === state.footerHost\n      && state.content.contains(state.footer);\n  }\n  function release(state) {\n    if (!state) return;\n    if (state.observer) state.observer.disconnect();\n    if (window.__ankiExamCountdownState !== state) return;\n    clearInterval(state.timer);\n    var activeFooter = document.querySelector('.exam-countdown');\n    // A retained model may have replaced our interval. Clear that old timer\n    // when no other note owns a footer, while leaving a foreign timer alone.\n    if (window.__ankiExamTimer === state.timer || !activeFooter || activeFooter === state.footer) stop();\n    // Remove our countdown before unwrapping, including a plain-card fallback\n    // whose footerHost is the content wrapper itself.\n    if (state.footer.parentElement === state.footerHost) state.footer.remove();\n    if (state.content.parentElement === state.host) {\n      while (state.content.firstChild) state.host.insertBefore(state.content.firstChild, state.content);\n      state.content.remove();\n    }\n    // Older helpers may have taken over the document layout. Release only\n    // the classes they owned when upgrading a still-mounted card.\n    (state.classes || []).forEach(function (item) {\n      if (!item.present) item.node.classList.remove(item.name);\n    });\n    if (document.getElementById(styleId) === state.style) {\n      if (state.styleText === null) state.style.remove();\n      else state.style.textContent = state.styleText;\n    }\n    window.__ankiExamCountdownState = null;\n  }\n  function mount() {\n    var previous = window.__ankiExamCountdownState;\n    if (previous && (!ownsHost(previous) || previous.layoutVersion !== 3)) release(previous);\n    stop();\n    var state = window.__ankiExamCountdownState;\n    var host = document.getElementById('qa') || document.getElementById('content') || document.body;\n    if (!host) return;\n    var style = document.getElementById(styleId);\n    var styleText = style ? style.textContent : null;\n    if (!style) {\n      style = document.createElement('style');\n      style.id = styleId;\n      (document.head || document.body).appendChild(style);\n    }\n    style.textContent = layoutCss;\n    var content = null;\n    Array.from(host.children).some(function (node) {\n      if (node.classList.contains('anki-countdown-content')) { content = node; return true; }\n      return false;\n    });\n    if (!content) {\n      content = document.createElement('div');\n      content.className = 'anki-countdown-content';\n      // Anki iterates a live script collection. Keep the field helper before\n      // the trailing card initializer when its containing card is wrapped.\n      host.insertBefore(content, host.firstChild);\n    }\n    var footer = host.querySelector('.exam-countdown') || document.querySelector('.exam-countdown');\n    if (!footer) {\n      footer = document.createElement('div');\n      footer.className = 'exam-countdown';\n    }\n    footer.setAttribute('role', 'timer');\n    footer.setAttribute('aria-live', 'off');\n    footer.title = '2027 考研初试：2026年12月19日 08:30（北京时间）';\n    document.querySelectorAll('.exam-countdown').forEach(function (node) {\n      if (node !== footer) node.remove();\n    });\n    Array.from(host.childNodes).forEach(function (node) {\n      if (node === content || node === footer || /^(SCRIPT|STYLE|LINK)$/.test(node.nodeName)) return;\n      content.appendChild(node);\n    });\n    var footerHost = content.querySelector('.examples-section') || content.querySelector('.vocab-back')\n      || content.querySelector('.vocab-front') || content;\n    footerHost.appendChild(footer);\n    if (!state) {\n      state = { host: host, content: content, footer: footer, footerHost: footerHost, style: style,\n                styleText: styleText, layoutVersion: 3, timer: null, observer: null, observing: false };\n      window.__ankiExamCountdownState = state;\n      // This lifecycle is independent of either timer: it still runs when the\n      // retained model replaced our interval or the target has already passed.\n      state.observer = new MutationObserver(function () {\n        if (window.__ankiExamCountdownState !== state) { state.observer.disconnect(); return; }\n        if (!ownsHost(state)) { release(state); return; }\n      });\n    }\n    if (!state.observing) {\n      state.observer.observe(document.body, { childList: true, subtree: true });\n      state.observing = true;\n    }\n    function render() {\n      var seconds = Math.max(0, Math.ceil((target - Date.now()) / 1000));\n      if (!seconds) { footer.textContent = '2027 考研初试已开始'; return false; }\n      footer.textContent = '2027 考研倒计时：' + Math.floor(seconds / 86400) + '天 '\n        + String(Math.floor(seconds % 86400 / 3600)).padStart(2, '0') + '时 '\n        + String(Math.floor(seconds % 3600 / 60)).padStart(2, '0') + '分 '\n        + String(seconds % 60).padStart(2, '0') + '秒';\n      return true;\n    }\n    if (render()) {\n      var timer = setInterval(function () {\n        if (!ownsHost(state)) { release(state); return; }\n        if (document.querySelector('.exam-countdown') !== footer || !render()) {\n          clearInterval(timer);\n          if (window.__ankiExamTimer === timer) window.__ankiExamTimer = null;\n        }\n      }, 1000);\n      state.timer = timer;\n      window.__ankiExamTimer = timer;\n    }\n  }\n  window.__ankiExamCountdownMount = mount;\n  window.__ankiExamCountdownCleanup = function () {\n    var state = window.__ankiExamCountdownState;\n    if (ownsHost(state)) {\n      stop();\n      state.observer.disconnect();\n      state.observing = false;\n    }\n    else release(state);\n  };\n  window.__ankiExamCountdownResume = function () {\n    var state = window.__ankiExamCountdownState;\n    if (ownsHost(state)) mount();\n    else release(state);\n  };\n  if (!window.__ankiExamCountdownLifecycleBound) {\n    window.__ankiExamCountdownLifecycleBound = true;\n    window.addEventListener('pagehide', function () { window.__ankiExamCountdownCleanup(); });\n    window.addEventListener('pageshow', function () { window.__ankiExamCountdownResume(); });\n  }\n  if (document.readyState === 'loading') {\n    var pendingHost = document.getElementById('qa') || document.getElementById('content') || document.body;\n    window.__ankiExamCountdownPending = {\n      host: pendingHost, anchor: pendingHost && (pendingHost.querySelector('.vocab-card') || pendingHost.firstElementChild)\n    };\n    if (!window.__ankiExamCountdownReadyBound) {\n      window.__ankiExamCountdownReadyBound = true;\n      document.addEventListener('DOMContentLoaded', function () {\n        window.__ankiExamCountdownReadyBound = false;\n        var pending = window.__ankiExamCountdownPending;\n        window.__ankiExamCountdownPending = null;\n        if (!pending || !pending.host || !document.documentElement.contains(pending.host)\n            || pending.anchor && !pending.host.contains(pending.anchor)) return;\n        window.__ankiExamCountdownMount();\n      }, { once: true });\n    }\n  } else mount();\n})();\n","src":"_study_deferred_inline_6cea87551da1b7dfea2fbfe01a0e184b41ee991442fd9a436859648e44b47334.js","sha256":"6cea87551da1b7dfea2fbfe01a0e184b41ee991442fd9a436859648e44b47334"},{"source":"(function(){\nconst key='__ankiCigenFrames';if(window[key]){window[key].refresh();return;}\nconst known=new WeakSet(),visible=new WeakSet();const selector='iframe.etymology-source-frame';\nfunction prepare(frame){const section=frame.closest('.etymology-section'),meaning=section?.closest('.meaning-section');if(!section||!meaning)return;const levels=[...meaning.children].find(item=>item.classList.contains('level-section'));if(levels&&(section.parentElement!==meaning||section.previousElementSibling!==levels))levels.after(section);if(section.style.marginTop!=='0.2rem'||section.style.marginBottom!=='0.65rem')section.style.margin='.2rem 0 .65rem';const sample=meaning.querySelector('.form-row')||meaning.querySelector('.primary-definition .field-content');if(sample){const text=getComputedStyle(sample);if(frame.style.fontSize!==text.fontSize)frame.style.fontSize=text.fontSize;if(frame.style.lineHeight!==text.lineHeight)frame.style.lineHeight=text.lineHeight;}}\nfunction theme(frame){const meaning=frame.closest('.meaning-section');if(!meaning)return;const text=getComputedStyle(frame),title=meaning.querySelector('.primary-definition .field-title'),callout=meaning.querySelector('.field-callout'),tag=meaning.querySelector('.level-list li');const metrics={'--ety-text-size':text.fontSize,'--ety-text-line':text.lineHeight};if(title){const style=getComputedStyle(title);Object.assign(metrics,{'--ety-title-size':style.fontSize,'--ety-title-line':style.lineHeight,'--ety-title-gap':style.marginBottom});}if(callout)metrics['--ety-section-space']=getComputedStyle(callout).paddingTop;if(tag){const style=getComputedStyle(tag);Object.assign(metrics,{'--ety-tag-size':style.fontSize,'--ety-tag-line':style.lineHeight,'--ety-tag-padding':style.padding,'--ety-tag-gap':getComputedStyle(tag.parentElement).gap});}frame.contentWindow.postMessage({type:'cigen:theme',metrics},'*');}\nfunction layout(frame){prepare(frame);if(!frame.contentWindow||frame.getBoundingClientRect().width\u003c=0)return;if(!visible.has(frame)){visible.add(frame);frame.style.height='1px';frame.srcdoc=frame.getAttribute('srcdoc');return;}const style=getComputedStyle(frame);frame.contentWindow.postMessage({type:'cigen:layout',font:{fontFamily:style.fontFamily,fontSize:style.fontSize,lineHeight:style.lineHeight,color:style.color}},'*');theme(frame);}\nconst sizes=new ResizeObserver(entries=>{for(const entry of entries)layout(entry.target);});\nfunction refresh(){for(const frame of document.querySelectorAll(selector)){if(!known.has(frame)){known.add(frame);sizes.observe(frame);frame.addEventListener('load',()=>layout(frame));}layout(frame);}}\nwindow.addEventListener('message',event=>{const data=event.data;if(!data||data.type!=='cigen:size'||!Number.isFinite(data.height)||data.height\u003c=0)return;const frame=[...document.querySelectorAll(selector)].find(item=>item.contentWindow===event.source);if(!frame)return;const value=Math.ceil(data.height)+'px';if(frame.style.height!==value)frame.style.height=value;});\nnew MutationObserver(refresh).observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['class','style','hidden']});\nwindow.addEventListener('resize',refresh);window[key]={refresh};refresh();\n})();","src":"_study_deferred_inline_6dc4685fe495463c00482898a011338c333907f3c2f93811529b8c0cef57c7ed.js","sha256":"6dc4685fe495463c00482898a011338c333907f3c2f93811529b8c0cef57c7ed"}]},"preparedIndex":{"src":"evidence/_study_prepared_index_63fafaaf7fd1bc92303854ae153c9b32b9cc93c73ddd99ecd01280a368b112ee.json","sha256":"63fafaaf7fd1bc92303854ae153c9b32b9cc93c73ddd99ecd01280a368b112ee","gzipSrc":"evidence/_study_prepared_index_330bc2744364789a2ddd701e45b1e5b34236efd346eacbe7c874c7ccaf802e41.json.gz"},"wrapperDelivery":"source-gzip.v1"}}